# ==== BIẾN MÔI TRƯỜNG (FILE MẪU - KHÔNG ĐIỀN KEY THẬT VÀO ĐÂY) ====
# File này bị commit lên git. Chỉ điền giá trị GIẢ. Key thật để trong file .env (đã gitignore)
# và khai báo trên Vercel > Settings > Environment Variables.

# --- Server-side (KHÔNG có tiền tố VITE_, chỉ dùng ở serverless/máy chủ) ---
# Gemini API key. Lấy tại Google AI Studio.
GEMINI_API_KEY="dan-key-that-vao-file-.env-hoac-vercel-env"

# Supabase (dùng ở serverless để xác thực người dùng gọi API AI)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="anon-public-key-cua-du-an-supabase"

# --- Client-side (CÓ tiền tố VITE_, được nhúng vào frontend khi build) ---
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="anon-public-key-cua-du-an-supabase"
